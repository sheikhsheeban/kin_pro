# Optional API keys for the Lookup Gateway. Only the gateway process reads this file.
# Without keys, Kin uses keyless providers: Open-Meteo (weather), Wikipedia (search), Google News RSS (news).
# Copy to .env (or data/.env) and fill in what you have.

# Brave Search API (free tier): https://brave.com/search/api/
BRAVE_API_KEY=

# NewsAPI (free developer tier): https://newsapi.org/
NEWSAPI_KEY=
